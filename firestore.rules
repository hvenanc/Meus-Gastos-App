rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/finance/state {
      function owner() { return request.auth != null && request.auth.uid == userId; }
      function validState() {
        return request.resource.data.keys().hasOnly(['schemaVersion', 'revision', 'payload', 'updatedAt'])
          && request.resource.data.schemaVersion in [1, 2, 3]
          && request.resource.data.revision is int
          && request.resource.data.payload is string
          && request.resource.data.payload.size() < 900001
          && request.resource.data.updatedAt == request.time;
      }
      allow read: if owner();
      allow create: if owner() && validState() && request.resource.data.revision == 1;
      allow update: if owner() && validState() && request.resource.data.revision == resource.data.revision + 1;
      allow delete: if false;
    }
  }
}
